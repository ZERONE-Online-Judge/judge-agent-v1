APP_ENV=production
INTERNAL_API_BASE_URL=https://judge.zerone01.kr/api
JUDGE_NODE_NAME=judge-1
JUDGE_NODE_SECRET=change-me-per-node
JUDGE_TOTAL_SLOTS=8
JUDGE_TESTCASE_PARALLELISM=1
JUDGE_AGENT_CONTAINER_CPUS=10
JUDGE_AGENT_CONTAINER_MEMORY=20g
JUDGE_WORK_ROOT=/var/lib/zerone-judge
JUDGE_AGENT_VERSION=0.1.0
JUDGE_POLL_INTERVAL_SECONDS=1
JUDGE_LONG_POLL_SECONDS=20
JUDGE_DEFAULT_TIME_LIMIT_SECONDS=3
JUDGE_SANDBOX_MODE=docker
JUDGE_SANDBOX_IMAGE=zerone-judge-agent:latest
JUDGE_SANDBOX_CPUS=1
JUDGE_SANDBOX_MEMORY_MB=512
JUDGE_SANDBOX_PIDS_LIMIT=128
JUDGE_OUTPUT_LIMIT_BYTES=1048576
JUDGE_RUN_ONCE=false
