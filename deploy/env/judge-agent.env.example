APP_ENV=production
INTERNAL_API_BASE_URL=https://zoj.kr/api
# Use deploy/use-internal-tls.sh to install certificate trust and set
# INTERNAL_API_BASE_URL=https://10.10.10.110:6443/api and
# SSL_CERT_FILE=/etc/zoj-tls/ca-certificates.crt and
# JUDGE_OBJECT_URL_ORIGINS=https://zoj.kr,http://zoj.kr,https://judge.zerone01.kr,http://judge.zerone01.kr
# Only /minio/ downloads from these explicit origins use the internal API origin.

JUDGE_NODE_NAME=
JUDGE_NODE_SECRET=
JUDGE_TOTAL_SLOTS=
JUDGE_TESTCASE_PARALLELISM=
JUDGE_AGENT_CONTAINER_CPUS=
JUDGE_AGENT_CONTAINER_MEMORY=

JUDGE_WORK_ROOT=/var/lib/zerone-judge

JUDGE_POLL_INTERVAL_SECONDS=1
JUDGE_LONG_POLL_SECONDS=20

JUDGE_DEFAULT_TIME_LIMIT_SECONDS=3
JUDGE_SANDBOX_MODE=isolate
JUDGE_CHECKER_SANDBOX_MODE=isolate

JUDGE_SANDBOX_MEMORY_MB=1024
JUDGE_SANDBOX_PIDS_LIMIT=128

JUDGE_ISOLATE_BOX_ID_BASE=100
JUDGE_ISOLATE_BOX_ID_COUNT=1000

JUDGE_OUTPUT_LIMIT_BYTES=10485760
JUDGE_RUN_ONCE=false
